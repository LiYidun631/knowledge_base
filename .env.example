# 知识库配置模板。操作系统环境变量优先级高于本文件。
# 独立运行时放在知识库项目根目录；嵌入 test_agent 时合并到宿主 .env，保留原有配置。
# 相对路径基于宿主项目根目录解析，而不是 Shell 当前工作目录。

# 应用基础配置（嵌入 test_agent 时，监听地址和端口由宿主 APP_HOST / APP_PORT 管理）
KNOWLEDGE_SERVICE_NAME="knowledge-service"
KNOWLEDGE_SERVICE_ENV="local"
KNOWLEDGE_SERVICE_DEBUG=false
KNOWLEDGE_SERVICE_HOST="127.0.0.1"
KNOWLEDGE_SERVICE_PORT=8000
KNOWLEDGE_SERVICE_API_PREFIX="/api/v1"
KNOWLEDGE_SERVICE_LOG_LEVEL="INFO"

# MySQL 数据库
# 独立运行需填写 mysql+asyncmy://用户名:密码@127.0.0.1:3306/数据库名?charset=utf8mb4。
# 数据库留空时复用 test_agent 的 CHAT_DB_* 配置，知识库表与聊天表共用 MySQL。
KNOWLEDGE_SERVICE_DATABASE_URL=

# 文件存储
# 默认将原始文件存入本地 data/knowledge_files，无需启动 RustFS。
# 部署服务器并使用 RustFS/S3 时，将此项改为 s3，并填写下方连接信息。
KNOWLEDGE_SERVICE_OBJECT_STORAGE_BACKEND="local"
# 以下连接参数仅在 OBJECT_STORAGE_BACKEND=s3 时生效。
KNOWLEDGE_SERVICE_OBJECT_STORAGE_ENDPOINT_URL="http://127.0.0.1:9000"
KNOWLEDGE_SERVICE_OBJECT_STORAGE_ACCESS_KEY="knowledge-service"
KNOWLEDGE_SERVICE_OBJECT_STORAGE_SECRET_KEY="knowledge-service-secret"
KNOWLEDGE_SERVICE_OBJECT_STORAGE_BUCKET="knowledge-files"
KNOWLEDGE_SERVICE_OBJECT_STORAGE_REGION="us-east-1"
# 只有将对象存储后端改成 local 时才会使用此目录。
KNOWLEDGE_SERVICE_STORAGE_ROOT="./data/knowledge_files"
KNOWLEDGE_SERVICE_MAX_UPLOAD_BYTES=52428800
KNOWLEDGE_SERVICE_ALLOWED_DOCUMENT_EXTENSIONS=[".txt",".md",".pdf",".docx",".html",".htm",".csv"]

# OCR 文字识别（百度千帆）
# API Key 填入下方 KNOWLEDGE_SERVICE_MODEL_API_KEYS 的 qianfan；必须选支持图片输入的兼容视觉模型。
# 知识库扫描 PDF 使用百度千帆 OpenAI 兼容视觉模型；test_agent 报告分析仍使用本地 PaddleOCR。
KNOWLEDGE_SERVICE_OCR_BASE_URL="https://qianfan.baidubce.com/v2"
KNOWLEDGE_SERVICE_OCR_CHAT_PATH="/chat/completions"
# 填写千帆控制台中已开通的 OCR/视觉模型名称或服务 ID。
KNOWLEDGE_SERVICE_OCR_MODEL_NAME=""
KNOWLEDGE_SERVICE_OCR_TIMEOUT_SECONDS=180
# 仅扫描 PDF 会上传渲染后的图片页；原生 PDF 文字仍在本地提取。
KNOWLEDGE_SERVICE_OCR_RENDER_DPI=160

# ChromaDB 向量存储
# ChromaDB 在应用进程内运行，向量数据持久化到此目录，不需要启动向量库容器。
KNOWLEDGE_SERVICE_CHROMA_PERSIST_DIRECTORY="./data/knowledge_chroma"

# 默认模型
# 默认 Embedding：阿里云百炼 text-embedding-v4；默认 Rerank：qwen3.7-text-rerank。
KNOWLEDGE_SERVICE_DEFAULT_EMBEDDING_PROFILE_NAME="aliyun-dashscope-embedding-v4"
KNOWLEDGE_SERVICE_DEFAULT_RERANK_PROFILE_NAME="aliyun-dashscope-qwen3.7-text-rerank"
KNOWLEDGE_SERVICE_DEFAULT_RERANK_PROVIDER="dashscope"
KNOWLEDGE_SERVICE_DEFAULT_RERANK_MODEL_NAME="qwen3.7-text-rerank"
KNOWLEDGE_SERVICE_DEFAULT_RERANK_BASE_URL="https://dashscope.aliyuncs.com/compatible-api/v1"
KNOWLEDGE_SERVICE_DEFAULT_RERANK_PATH="/reranks"
KNOWLEDGE_SERVICE_DEFAULT_RERANK_SECRET_REF="dashscope"

# Embedding 模型预设
# 默认建库使用 aliyun-dashscope-embedding-v4。
# 需要把其他预设登记到数据库时，将对应项目的 enabled 改为 true，然后执行：
# uv run provision-knowledge-catalog --env
# 模型地址、名称和向量维度应以服务商控制台为准；不要在这里填写 API Key。
KNOWLEDGE_SERVICE_EMBEDDING_MODEL_PRESETS='[{"name":"openai-text-embedding-3-small","provider":"openai_compatible","base_url":"https://api.openai.com/v1","model_name":"text-embedding-3-small","dimensions":1536,"enabled":false},{"name":"aliyun-dashscope-embedding-v4","secret_ref":"dashscope","provider":"dashscope","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","model_name":"text-embedding-v4","dimensions":1024,"embedding_path":"/embeddings","batch_size":10,"enabled":false},{"name":"zhipu-bigmodel-embedding-3","secret_ref":"bigmodel","provider":"bigmodel","base_url":"https://open.bigmodel.cn/api/paas/v4","model_name":"embedding-3","dimensions":2048,"embedding_path":"/embeddings","batch_size":16,"enabled":false},{"name":"volcengine-embedding","secret_ref":"volcengine","requires_model_name":true,"provider":"volcengine","base_url":"https://ark.cn-beijing.volces.com/api/v3","model_name":"YOUR_VOLCENGINE_EMBEDDING_ENDPOINT_ID","dimensions":2048,"embedding_path":"/embeddings/multimodal","batch_size":1,"request_format":"volcengine_multimodal","enabled":false},{"name":"baidu-qianfan-embedding-v1","secret_ref":"qianfan","provider":"qianfan","base_url":"https://qianfan.baidubce.com/v2","model_name":"Embedding-V1","dimensions":384,"embedding_path":"/embeddings","batch_size":16,"enabled":false},{"name":"deepseek-chat-reserved","provider":"deepseek","base_url":"https://api.deepseek.com/v1","model_name":"deepseek-chat","secret_ref":"deepseek","supports_embedding":false,"enabled":false}]'
# 手动新增的模型档案只保存模型配置和密钥引用，不要把 API Key 写进 JSON。
KNOWLEDGE_SERVICE_ADDITIONAL_MODEL_PROFILES=[]
# 模型 API Key（填写平台颁发的真实密钥，平台名只是字段名称）
# 百炼填 dashscope；知识库 OCR 的千帆密钥填 qianfan；不要把平台名称当作密钥填写。
KNOWLEDGE_SERVICE_MODEL_API_KEYS='{"dashscope":"","bigmodel":"","volcengine":"","deepseek":"","qianfan":""}'

# Embedding 请求配置（超时单位：秒；批量大小还受供应商限制）
KNOWLEDGE_SERVICE_EMBEDDING_TIMEOUT_SECONDS=60
KNOWLEDGE_SERVICE_EMBEDDING_BATCH_SIZE=64

# 文档父子分块（长度单位：字符；重叠长度必须小于子块长度）
KNOWLEDGE_SERVICE_PARENT_CHUNK_CHARS=1800
KNOWLEDGE_SERVICE_CHILD_CHUNK_CHARS=600
KNOWLEDGE_SERVICE_CHILD_CHUNK_OVERLAP_CHARS=80

# 离线入库任务（时间单位：秒；任务与 API 在同一进程运行）
# 最大尝试次数、重试间隔、超时任务回收、轮询间隔、每次回收数量。
KNOWLEDGE_SERVICE_MAX_INGESTION_ATTEMPTS=3
KNOWLEDGE_SERVICE_INGESTION_RETRY_BASE_SECONDS=15
KNOWLEDGE_SERVICE_STALE_JOB_TIMEOUT_SECONDS=1800
KNOWLEDGE_SERVICE_INGESTION_POLL_SECONDS=2
KNOWLEDGE_SERVICE_RECOVERY_BATCH_SIZE=100
