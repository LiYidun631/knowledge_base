# 知识库配置模板。操作系统环境变量优先级高于本文件。
# 独立运行时放在知识库项目根目录；嵌入 test_agent 时合并到宿主 .env，保留原有配置。
# 相对路径基于宿主项目根目录解析，而不是 Shell 当前工作目录。

# 应用基础配置（嵌入 test_agent 时，监听地址和端口由宿主 APP_HOST / APP_PORT 管理）
KNOWLEDGE_SERVICE_NAME="knowledge-service"
KNOWLEDGE_SERVICE_ENV="local"
KNOWLEDGE_SERVICE_DEBUG=false
KNOWLEDGE_SERVICE_HOST="127.0.0.1"
KNOWLEDGE_SERVICE_PORT=8333
# 图片链接使用的服务公开地址；本地端口变化时同步修改，部署后填写域名或网关地址。
KNOWLEDGE_SERVICE_PUBLIC_BASE_URL="http://127.0.0.1:8333"
KNOWLEDGE_SERVICE_API_PREFIX="/api/v1"
KNOWLEDGE_SERVICE_LOG_LEVEL="INFO"

# 独立服务鉴权：管理员 Token 必须非空，否则业务请求返回 503；健康检查公开。
# 管理员 Token 可跨公司管理，仅供运维使用，严禁填入 test_agent 客户端。
# 公司凭据的签发/重置/停用 API 即使在嵌入模式也必须携带管理员 Bearer。
KNOWLEDGE_SERVICE_AUTH_ADMIN_TOKEN=""
# 公司凭据由管理员通过 GET/POST /api/v1/companies/{company_id}/tokens 列表/签发、
# POST /tokens/{credential_id}/reset 重置、DELETE /tokens/{credential_id} 停用。
# 每家公司可签发多枚按项目命名的凭据并独立管理，company_credentials 只存 SHA-256 哈希；每请求查库，无鉴权缓存。
# 多枚凭据只区分接入身份，权限仍以公司为边界（可访问本公司全部子库），不做项目级数据隔离。
# 签发/重置仅限 active 公司，同公司内名称不可重复；明文只返回一次，请求或响应丢失请管理员重置，不要重试签发。
# 停用保留哈希；重置替换该凭据 Token 并启用。后续新请求立即生效，不中断已在途请求，无需重启服务端。
# 旧公司 Token 环境映射不再支持；0014_company_credentials 仅建空表，0025_multi_company_credentials
# 把单凭据升级为多凭据并保留原 Token 为「默认凭据」。真实数据库迁移和 .env 更新须先核对目标与备份。
# test_agent 只填 API 签发的对应项目公司凭据（禁止管理员 Token）。
# 跨机器建议 HTTPS；禁止将 Token、Authorization 头或含 Token 的响应写入日志。

# 管理端模型 API Key 加密密钥（Fernet 密钥，32 字节 base64）
# 由管理员通过 /api/v1/admin/model-profiles/{id}/api-key 单独写入的密钥用它加密后入库，任何接口都不回读明文。
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 留空时该写密钥接口返回 503，其余功能不受影响；丢失或更换本密钥后已存密钥无法解密，需重新写入。
KNOWLEDGE_SERVICE_CREDENTIAL_ENCRYPTION_KEY=""

# MySQL 数据库
# 独立运行需填写 mysql+asyncmy://用户名:密码@127.0.0.1:3306/数据库名?charset=utf8mb4。
# 数据库留空时复用 test_agent 的 CHAT_DB_* 配置，知识库表与聊天表共用 MySQL。
KNOWLEDGE_SERVICE_DATABASE_URL=

# 文件存储
# 默认将原始文件存入本地 data/knowledge_files，无需启动 RustFS。
# 部署服务器并使用 RustFS/S3 时，将此项改为 s3，并填写下方连接信息。
KNOWLEDGE_SERVICE_OBJECT_STORAGE_BACKEND="local"
# 以下连接参数仅在 OBJECT_STORAGE_BACKEND=s3 时生效。
KNOWLEDGE_SERVICE_OBJECT_STORAGE_ENDPOINT_URL="http://127.0.0.1:9000"
KNOWLEDGE_SERVICE_OBJECT_STORAGE_ACCESS_KEY="knowledge-service"
KNOWLEDGE_SERVICE_OBJECT_STORAGE_SECRET_KEY="knowledge-service-secret"
KNOWLEDGE_SERVICE_OBJECT_STORAGE_BUCKET="knowledge-files"
KNOWLEDGE_SERVICE_OBJECT_STORAGE_REGION="us-east-1"
# 只有将对象存储后端改成 local 时才会使用此目录。
KNOWLEDGE_SERVICE_STORAGE_ROOT="./data/knowledge_files"
KNOWLEDGE_SERVICE_MAX_UPLOAD_BYTES=52428800
# 后台传入文件链接时，知识库服务下载原文件的超时时间（秒）。
KNOWLEDGE_SERVICE_SOURCE_DOWNLOAD_TIMEOUT_SECONDS=120
# 允许上传的扩展名；旧版 DOC/XLS/PPT 和 ODT/ODS/ODP 需要 LibreOffice 转换。
KNOWLEDGE_SERVICE_ALLOWED_DOCUMENT_EXTENSIONS=[".txt",".md",".pdf",".doc",".docx",".docm",".rtf",".xls",".xlsx",".xlsm",".ppt",".pptx",".pptm",".odt",".ods",".odp",".html",".htm",".xml",".csv",".json",".log",".bmp",".gif",".jpeg",".jpg",".png",".tif",".tiff",".webp"]
# LibreOffice 的 soffice.exe 路径。留空时自动从 PATH 查找；没有旧版 Office 文件时也可以留空。
KNOWLEDGE_SERVICE_OFFICE_CONVERTER_PATH=
KNOWLEDGE_SERVICE_OFFICE_CONVERTER_TIMEOUT_SECONDS=120

# OCR 文字识别（默认使用百炼通义千问视觉模型）
# API Key 填入 KNOWLEDGE_SERVICE_MODEL_API_KEYS 的 dashscope；模型必须支持图片输入。
KNOWLEDGE_SERVICE_OCR_SECRET_REF="dashscope"
KNOWLEDGE_SERVICE_OCR_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
KNOWLEDGE_SERVICE_OCR_CHAT_PATH="/chat/completions"
# 填写百炼控制台中已开通的视觉模型名称；可按账号权限改为其他 qwen-vl 模型。
KNOWLEDGE_SERVICE_OCR_MODEL_NAME="qwen-vl-plus"
KNOWLEDGE_SERVICE_OCR_TIMEOUT_SECONDS=180
# PDF 页面渲染分辨率；仅被选中的页面会上传渲染图片。
KNOWLEDGE_SERVICE_OCR_RENDER_DPI=160
# PDF 扫描页的 OCR 并发数；建议 2-4，过高可能触发视觉模型限流。
KNOWLEDGE_SERVICE_OCR_PAGE_CONCURRENCY=3
# 是否启用 PDF 版面分析。
KNOWLEDGE_SERVICE_OCR_LAYOUT_ANALYSIS_ENABLED=true
# auto：仅分析没有文字层的扫描页，普通 PDF 不会逐页调用模型；all：分析每一页。
KNOWLEDGE_SERVICE_OCR_LAYOUT_ANALYSIS_MODE=auto
# 是否识别 DOCX/PPTX 内嵌图片；关闭后仍保存图片资产，但不生成图片文字说明。
KNOWLEDGE_SERVICE_OCR_EMBEDDED_IMAGES_ENABLED=true
# Office 内嵌图片 OCR 的单张超时时间；超时后原图仍会保存，文档继续入库。
KNOWLEDGE_SERVICE_OCR_EMBEDDED_TIMEOUT_SECONDS=60
# 同一份文档同时提交的图片 OCR 请求数；建议 2-4，避免触发供应商限流。
KNOWLEDGE_SERVICE_OCR_EMBEDDED_CONCURRENCY=3
# Office 内嵌图片低于以下条件时只保存原图，不调用视觉模型。
KNOWLEDGE_SERVICE_OCR_EMBEDDED_IMAGE_MIN_BYTES=512
KNOWLEDGE_SERVICE_OCR_EMBEDDED_IMAGE_MIN_WIDTH=64
KNOWLEDGE_SERVICE_OCR_EMBEDDED_IMAGE_MIN_HEIGHT=48

# ChromaDB 向量存储
# ChromaDB 在应用进程内运行，向量数据持久化到此目录，不需要启动向量库容器。
KNOWLEDGE_SERVICE_CHROMA_PERSIST_DIRECTORY="./data/knowledge_chroma"

# 默认模型
# 公司级大库创建接口可选传 embedding_model_id / rerank_model_id（管理页选模型）；不传则使用这里配置的默认档案。
# 模型在创建时锁定，已有内容的库不能更换；换模型需新建库。Rerank 显式传 null 表示该库不使用 Rerank。
# 默认 Embedding：阿里云百炼 text-embedding-v4；默认 Rerank：qwen3.7-text-rerank。
KNOWLEDGE_SERVICE_DEFAULT_EMBEDDING_PROFILE_NAME="aliyun-dashscope-embedding-v4"
KNOWLEDGE_SERVICE_DEFAULT_RERANK_PROFILE_NAME="aliyun-dashscope-qwen3.7-text-rerank"
KNOWLEDGE_SERVICE_DEFAULT_RERANK_PROVIDER="dashscope"
KNOWLEDGE_SERVICE_DEFAULT_RERANK_MODEL_NAME="qwen3.7-text-rerank"
KNOWLEDGE_SERVICE_DEFAULT_RERANK_BASE_URL="https://dashscope.aliyuncs.com/compatible-api/v1"
KNOWLEDGE_SERVICE_DEFAULT_RERANK_PATH="/reranks"
KNOWLEDGE_SERVICE_DEFAULT_RERANK_SECRET_REF="dashscope"

# Embedding 模型预设（仅开发人员配置）
# 默认建库固定使用 aliyun-dashscope-embedding-v4，业务请求不能选择模型。
# 需要切换默认模型时，由开发人员修改默认名称及对应配置，然后执行：
# uv run provision-knowledge-catalog --env
# 模型地址、名称和向量维度应以服务商控制台为准；不要在这里填写 API Key。
KNOWLEDGE_SERVICE_EMBEDDING_MODEL_PRESETS='[{"name":"openai-text-embedding-3-small","provider":"openai_compatible","base_url":"https://api.openai.com/v1","model_name":"text-embedding-3-small","dimensions":1536,"enabled":false},{"name":"aliyun-dashscope-embedding-v4","secret_ref":"dashscope","provider":"dashscope","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","model_name":"text-embedding-v4","dimensions":1024,"embedding_path":"/embeddings","batch_size":10,"enabled":false},{"name":"zhipu-bigmodel-embedding-3","secret_ref":"bigmodel","provider":"bigmodel","base_url":"https://open.bigmodel.cn/api/paas/v4","model_name":"embedding-3","dimensions":2048,"embedding_path":"/embeddings","batch_size":16,"enabled":false},{"name":"volcengine-embedding","secret_ref":"volcengine","requires_model_name":true,"provider":"volcengine","base_url":"https://ark.cn-beijing.volces.com/api/v3","model_name":"YOUR_VOLCENGINE_EMBEDDING_ENDPOINT_ID","dimensions":2048,"embedding_path":"/embeddings/multimodal","batch_size":1,"request_format":"volcengine_multimodal","enabled":false},{"name":"baidu-qianfan-embedding-v1","secret_ref":"qianfan","provider":"qianfan","base_url":"https://qianfan.baidubce.com/v2","model_name":"Embedding-V1","dimensions":384,"embedding_path":"/embeddings","batch_size":16,"enabled":false},{"name":"deepseek-chat-reserved","provider":"deepseek","base_url":"https://api.deepseek.com/v1","model_name":"deepseek-chat","secret_ref":"deepseek","supports_embedding":false,"enabled":false}]'
# 手动新增的模型档案只保存模型配置和密钥引用，不要把 API Key 写进 JSON。
KNOWLEDGE_SERVICE_ADDITIONAL_MODEL_PROFILES=[]
# 模型 API Key（填写平台颁发的真实密钥，平台名只是字段名称）
# 百炼填 dashscope；知识库 OCR 的千帆密钥填 qianfan；不要把平台名称当作密钥填写。
KNOWLEDGE_SERVICE_MODEL_API_KEYS='{"dashscope":"","bigmodel":"","volcengine":"","deepseek":"","qianfan":""}'

# Embedding 请求配置（超时单位：秒；批量大小还受供应商限制）
KNOWLEDGE_SERVICE_EMBEDDING_TIMEOUT_SECONDS=60
KNOWLEDGE_SERVICE_EMBEDDING_BATCH_SIZE=64

# 文档父子分块（长度单位：字符；重叠长度必须小于子块长度）
# 下面三项是全局默认值；每个子库可在创建或更新接口单独覆盖，改配置只影响之后入库的新文档。
KNOWLEDGE_SERVICE_PARENT_CHUNK_CHARS=1800
KNOWLEDGE_SERVICE_CHILD_CHUNK_CHARS=600
KNOWLEDGE_SERVICE_CHILD_CHUNK_OVERLAP_CHARS=80

# 离线入库任务（时间单位：秒；任务与 API 在同一进程运行）
# 最大尝试次数、重试间隔、超时任务回收、轮询间隔、每次回收数量。
KNOWLEDGE_SERVICE_MAX_INGESTION_ATTEMPTS=3
KNOWLEDGE_SERVICE_INGESTION_RETRY_BASE_SECONDS=15
KNOWLEDGE_SERVICE_STALE_JOB_TIMEOUT_SECONDS=1800
KNOWLEDGE_SERVICE_INGESTION_POLL_SECONDS=2
KNOWLEDGE_SERVICE_RECOVERY_BATCH_SIZE=100

# 在线检索（hybrid 默认使用 BM25 + Chroma 向量召回，再按加权 RRF 融合）
# 每个召回通道最多召回的候选子块数；版本很多时会按下方批量值分批查询 Chroma。
KNOWLEDGE_SERVICE_SEARCH_CANDIDATE_K=40
KNOWLEDGE_SERVICE_SEARCH_VERSION_FILTER_BATCH_SIZE=500
# 接口允许返回的最大父块数量。
KNOWLEDGE_SERVICE_SEARCH_MAX_TOP_K=20
# RRF 常数和通道权重；权重越高，该通道的排名对最终结果影响越大。
KNOWLEDGE_SERVICE_SEARCH_RRF_K=60
KNOWLEDGE_SERVICE_SEARCH_VECTOR_WEIGHT=0.7
KNOWLEDGE_SERVICE_SEARCH_BM25_WEIGHT=0.3
# 单次查询最多取用的不同词项数量，防止超长查询扩大数据库扫描范围。
KNOWLEDGE_SERVICE_SEARCH_MAX_QUERY_TERMS=256
# BM25 相关度参数；通常保持默认值即可。
KNOWLEDGE_SERVICE_BM25_K1=1.5
KNOWLEDGE_SERVICE_BM25_B=0.75
# 绑定 Rerank 模型时的请求超时。
KNOWLEDGE_SERVICE_RERANK_TIMEOUT_SECONDS=30

# 在线问答生成模型（检索结果会先作为上下文，再由此模型生成最终答案）
# 默认使用百炼 OpenAI 兼容接口；API Key 复用上方 MODEL_API_KEYS 中的 dashscope。
KNOWLEDGE_SERVICE_CHAT_PROVIDER="dashscope"
KNOWLEDGE_SERVICE_CHAT_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
KNOWLEDGE_SERVICE_CHAT_PATH="/chat/completions"
KNOWLEDGE_SERVICE_CHAT_MODEL_NAME="qwen-plus"
KNOWLEDGE_SERVICE_CHAT_SECRET_REF="dashscope"
KNOWLEDGE_SERVICE_CHAT_TIMEOUT_SECONDS=60
# 忠实还原原文时使用 0，减少总结、扩写和事实改写。
KNOWLEDGE_SERVICE_CHAT_TEMPERATURE=0.0
# 客服角色中的品牌或产品名称，会替换提示词文件中的 {{brand_name}}。
KNOWLEDGE_SERVICE_CHAT_BRAND_NAME="知识库产品"
# 提示词正文单独放在此文件中，支持多行中文编辑；资料片段会由程序以“资料N”编号注入。
KNOWLEDGE_SERVICE_CHAT_SYSTEM_PROMPT_FILE="./prompts/knowledge_answer_system.txt"
# 可选上下文扩展：命中父块前后各读取的父块数量，以及单条结果的上下文字符上限。
KNOWLEDGE_SERVICE_SEARCH_CONTEXT_BEFORE=1
KNOWLEDGE_SERVICE_SEARCH_CONTEXT_AFTER=1
KNOWLEDGE_SERVICE_SEARCH_MAX_CONTEXT_CHARS=12000
